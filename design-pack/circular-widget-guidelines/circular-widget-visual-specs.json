            "text": {
              "value": { "fontSize": 42, "lineHeight": 44.5, "centerX": 74.5, "centerY": 74.5, "box": { "x": 41, "y": 52, "width": 67, "height": 45 } },
              "label": { "fontSize": 18, "lineHeight": 20.5, "centerX": 74.5, "centerY": 107.5, "box": { "x": 57, "y": 97, "width": 35, "height": 21 } }
            }
          }
        },
        "arc": {
          "track": {
            "draw": "full_circle",
            "colorToken": "trackGray",
            "lineCap": "round"
          },
          "progress": {
            "draw": "partial_arc",
            "startAngle": 270,
            "maxSweepAngle": 300,
            "direction": "clockwise",
            "lineCap": "round",
            "colorToken": "progress"
          }
        },
        "colors": {
          "defaults": {
            "progress": "widget_accent_color",
            "track": "rgba(140, 140, 140, 0.28)",
            "valueText": "widget_accent_color",
            "labelText": "widget_accent_color",
            "icon": "widget_accent_color"
          },
          "contentAware": false,
          "sourceOfTruth": "watch-face-generation-rules.md widget_accent_color"
        }
      },
      "preferredWebImplementation": {
        "container": "position: relative; width: diameter; height: diameter;",
        "svg": "absolute inset: 0; width: 100%; height: 100%; overflow: visible;",
        "ring": "Use SVG path arcs with stroke-width from the size token and stroke-linecap='round'.",
        "text": "Absolutely position text boxes using the box values, center-align, and use sharedTypography."
      },
      "exampleProps": {
        "component": "close_gauge",
        "variant": { "property": "text", "size": "L" },
        "data": {
          "value": "100",
          "label": "text",
          "progress": 0.72,
          "metricKind": "activity"
        }
      }
    },
    "open_gauge": {
      "figmaReference": {
        "componentSetNodeId": "560:885",
        "componentName": "Open Gauge"
      },
      "semanticComponentSpec": {
        "description": "Open arc gauge for a metric with optional icon, text, range labels, or offset/reference comparison.",
        "validProperties": ["text", "icon", "range", "offset"],
        "validSizes": ["S", "M", "L"]
      },
      "variantApi": {
        "component": "open_gauge",
        "variant": {
          "property": "text|icon|range|offset",
          "size": "S|M|L"
        },
        "data": {
          "value": "required for text, range, and offset",
          "label": "required for property=text",
          "icon": "required for property=icon",
          "min": "required for range and offset measured-dot placement",
          "max": "required for range and offset measured-dot placement",
          "lowLabel": "required for property=range",
          "highLabel": "required for property=range",
          "referenceValue": "required for property=offset",
          "measuredValue": "optional numeric override for the primary measured dot; defaults to value",
          "referenceMeasuredValue": "optional numeric value for the second offset dot",
          "metricKind": "optional semantic color hint"
        }
      },
      "exactVisualTokens": {
        "shape": "open_arc_gauge",
        "sizes": {
          "S": {
            "diameter": 72,
            "strokeWidth": 8,
            "radius": 31.5,
            "center": { "x": 36, "y": 36 },
            "measureDot": { "diameter": 8.21, "strokeWidth": 2 },
            "iconBox": { "x": 20, "y": 20, "width": 32, "height": 32 },
            "text": {
              "current": { "fontSize": 22, "lineHeight": 24.5, "centerX": 36, "centerY": 36, "box": { "x": 18, "y": 23, "width": 35, "height": 25 } },
              "low": { "fontSize": 15, "lineHeight": 17.5, "box": { "x": 13.05, "y": 54, "width": 19, "height": 18 }, "align": "left" },
              "high": { "fontSize": 15, "lineHeight": 17.5, "box": { "x": 40.07, "y": 54, "width": 19, "height": 18 }, "align": "right" },
              "reference": { "fontSize": 15, "lineHeight": 17.5, "box": { "x": 26.54, "y": 54, "width": 18, "height": 18 }, "align": "center" }
            }
          },
          "M": {
            "diameter": 90,
            "strokeWidth": 10,
            "radius": 39.5,
            "center": { "x": 45, "y": 45 },
            "measureDot": { "diameter": 10.27, "strokeWidth": 2 },
            "iconBox": { "x": 26, "y": 26, "width": 38, "height": 38 },
            "text": {
              "current": { "fontSize": 32, "lineHeight": 34.5, "centerX": 45, "centerY": 45, "box": { "x": 19, "y": 27, "width": 51, "height": 35 } },
              "low": { "fontSize": 18, "lineHeight": 20.5, "box": { "x": 16.31, "y": 69, "width": 23, "height": 21 }, "align": "left" },
              "high": { "fontSize": 18, "lineHeight": 20.5, "box": { "x": 50.34, "y": 69, "width": 23, "height": 21 }, "align": "right" },
              "reference": { "fontSize": 18, "lineHeight": 20.5, "box": { "x": 34.43, "y": 69, "width": 21, "height": 21 }, "align": "center" }
            }
          },
          "L": {
            "diameter": 149,
            "strokeWidth": 15,
            "radius": 66.5,
            "center": { "x": 74.5, "y": 74.5 },
            "measureDot": { "diameter": 17, "strokeWidth": 3 },
            "iconBox": { "x": 42, "y": 43, "width": 64, "height": 64 },
            "text": {
              "current": { "fontSize": 48, "lineHeight": 44.5, "centerX": 74.5, "centerY": 74.5, "box": { "x": 36, "y": 52, "width": 77, "height": 45 } },
              "low": { "fontSize": 32, "lineHeight": 44.5, "box": { "x": 27, "y": 104, "width": 38, "height": 45 }, "align": "left" },
              "high": { "fontSize": 32, "lineHeight": 44.5, "box": { "x": 85, "y": 104, "width": 38, "height": 45 }, "align": "right" },
              "reference": { "fontSize": 32, "lineHeight": 44.5, "box": { "x": 57, "y": 104, "width": 35, "height": 45 }, "align": "center" }
            }
          }
        },
        "arc": {
          "track": {
            "draw": "open_arc",
            "startAngle": 135,
            "sweepAngle": 270,
            "direction": "clockwise",
            "lineCap": "round",
            "colorToken": "trackDark",
            "visibleFor": ["text", "icon", "offset"],
            "optionalFor": ["range"]
          },
          "progress": {
            "draw": "open_arc",
            "startAngle": 135,
            "sweepAngle": 270,
            "direction": "clockwise",
            "lineCap": "round",
            "colorToken": "gradient",
            "gradientDirection": "along_arc_from_low_to_high"
          }
        },
        "measureDots": {
          "appliesTo": ["range", "offset"],
          "sourceFigmaLayerName": "measure",
          "dynamicPositionRequired": true,
          "dotCenterFormula": {
            "normalized": "clamp((measuredValue - min) / (max - min), 0, 1)",
            "angle": "135 + normalized * 270",
            "x": "center.x + radius * cos(degToRad(angle))",
            "y": "center.y + radius * sin(degToRad(angle))"
          },
          "edgeMapping": {
            "normalized0": "left/lower edge of open ring",
            "normalized0_5": "top center of open ring",
            "normalized1": "right/lower edge of open ring"
          },
          "weatherTemperatureExample": {
            "low": 55,
            "high": 68,
            "current": 68,
            "normalized": 1,
            "expected": "The measured dot sits at the right edge of the gauge ring."
          },
          "rangeVariant": {
            "dots": [
              {
                "id": "current_measure",
                "valueSource": "measuredValue || value",
                "colorSource": "color interpolated between start_color and end_color by normalized measured value; widget_accent_color when one-color mode is used"
              }
            ]
          },
          "offsetVariant": {
            "dots": [
              {
                "id": "reference_measure",
                "valueSource": "referenceMeasuredValue || referenceValue",
                "colorSource": "set_color"
              },
              {
                "id": "current_measure",
                "valueSource": "measuredValue || value",
                "colorSource": "offset_color"
              }
            ]
          },
          "style": {
            "fill": "rulebook-resolved accent color",
            "stroke": "#000000",
            "strokeWidth": "size.measureDot.strokeWidth"
          }
        },
        "colors": {
          "defaults": {
            "singleAccent": "widget_accent_color",
            "rangeGradient": ["start_color", "end_color"],
            "offsetGradient": ["set_color", "offset_color"],
            "track": "#3D3D3D",
            "textIconInterpolatedColor": "interpolate(start_color, end_color, normalized_measure_position)",
            "lowText": "start_color",
            "highText": "end_color",
            "setText": "set_color",
            "offsetText": "offset_color"
          },
          "contentAware": false,
          "sourceOfTruth": "watch-face-generation-rules.md"
        }
      },
      "preferredWebImplementation": {
        "container": "position: relative; width: diameter; height: diameter;",
        "svg": "absolute inset: 0; width: 100%; height: 100%; overflow: visible;",
        "ring": "Use SVG path arcs with stroke-width from the size token and stroke-linecap='round'.",
        "gradient": "Use an SVG linearGradient or conic-gradient-derived stroke approximation. The visual intent is a smooth color transition along the open arc.",
        "dots": "Render each measure dot as an SVG circle whose center is computed from the normalized value and open-arc angle mapping.",
        "text": "Absolutely position text boxes using the box values, center-align current and reference text, and use sharedTypography."
      },
      "exampleProps": {
        "component": "open_gauge",
        "variant": { "property": "range", "size": "M" },
        "data": {
          "value": "68",
          "min": 55,
          "max": 68,
          "lowLabel": "55",
          "highLabel": "68",
          "measuredValue": 68,
          "metricKind": "weather_temperature"
        }
      }
    }
  },
  "validationRules": [
    {
      "id": "open-gauge-max-dot-right-edge",
      "strictness": "must",
      "rule": "For open_gauge range and offset variants, a measured value equal to max must place the measured dot at normalized=1, which maps to the right/lower edge of the open gauge ring."
    },
    {
      "id": "open-gauge-min-dot-left-edge",
      "strictness": "must",
      "rule": "For open_gauge range and offset variants, a measured value equal to min must place the measured dot at normalized=0, which maps to the left/lower edge of the open gauge ring."
    },
    {
      "id": "open-gauge-mid-dot-top",
      "strictness": "must",
      "rule": "For open_gauge range and offset variants, a measured value halfway between min and max must place the measured dot at normalized=0.5, which maps to the top center of the open gauge ring."
    },
    {
      "id": "color-choice-preserves-shape",
      "strictness": "must",
      "rule": "Rulebook-resolved color choices must not change size, stroke width, text position, arc angle, or measured-dot position."
    }
  ]
}
