{
  "schemaVersion": "1.0.0",
  "purpose": "Exact webpage rendering specs for watch-face circular gauges. Agents should use these specs to generate HTML/CSS/SVG instead of inferring visuals from screenshots.",
  "coordinateSystem": {
    "unit": "px",
    "origin": "top-left",
    "angleConvention": {
      "degrees": true,
      "zeroDegrees": "right edge of the circle",
      "positiveDirection": "clockwise",
      "examples": {
        "0": "right",
        "90": "bottom",
        "180": "left",
        "270": "top"
      }
    }
  },
  "webImplementation": {
    "preferred": "inline_svg_with_html_text_overlay",
    "requirements": [
      "Render rings and measured dots in SVG for precise geometry.",
      "Render text either as absolutely positioned HTML or SVG text using the provided typography tokens.",
      "Use vector-effect='non-scaling-stroke' only if the SVG viewBox is scaled by CSS; otherwise render at the exact size token.",
      "Do not rasterize the Figma component for final webpage UI.",
      "Do not stretch circular gauges outside their fixed size token."
    ],
    "arcMath": {
      "pointOnCircle": "angleRadians = degToRad(angleDegrees); x = centerX + radius * cos(angleRadians); y = centerY + radius * sin(angleRadians)",
      "normalizedValue": "normalized = clamp((value - min) / (max - min), 0, 1)",
      "angleForMeasuredDot": "angle = arc.startAngle + normalized * arc.sweepAngle",
      "invalidRangeFallback": "If max equals min, set normalized to 0.5 and do not imply precision."
    }
  },
  "colorPolicy": {
    "agentMayChooseColors": false,
    "rule": "Circular widget colors are resolved by watch-face-generation-rules.md before rendering. Components consume widget_accent_color or the component-specific two-color open gauge rule; they do not invent independent colors.",
    "sourceOfTruth": "watch-face-generation-rules.md widget_accent_color",
    "minimumContrast": {
      "primaryTextOnBlack": "4.5:1",
      "secondaryTextOnBlack": "3:1",
      "measuredDotAgainstRing": "3:1 or use black outline"
    },
    "fixedDefaults": {
      "background": "#1F1F1F",
      "trackGray": "rgba(140, 140, 140, 0.28)",
      "trackDark": "#3D3D3D",
      "primaryText": "#FFFFFF",
      "secondaryText": "rgba(242, 244, 252, 0.6)",
      "dotOutline": "#000000"
    },
    "closeGauge": {
      "accentColorCount": 1,
      "accentColorSource": "widget_accent_color",
      "rules": [
        "Apply widget_accent_color to the text, icon, number, and value arc.",
        "The base ring always uses fixedDefaults.trackGray.",
        "Do not use gradients in close_gauge."
      ]
    },
    "openGauge": {
      "accentColorCount": "1_or_2",
      "colorSource": "watch-face-generation-rules.md",
      "oneColorMode": {
        "color": "widget_accent_color",
        "rules": [
          "The open ring, measure, text, number, and icon use widget_accent_color."
        ]
      },
      "twoColorMode": {
        "colors": ["start_color", "end_color"],
        "rules": [
          "The open ring uses start_color to end_color as a gradient.",
          "For open_gauge.text and open_gauge.icon, the measure, text, number, and icon use the interpolated color between start_color and end_color based on normalized measure position.",
          "For open_gauge.range, the low number uses start_color and the high number uses end_color.",
          "For open_gauge.offset, assign the two colors as set and offset colors. Set text and measure use set_color; offset text and measure use offset_color. The value arc uses the gradient from set_color to offset_color."
        ]
      }
    }
  },
  "sharedTypography": {
    "fontFamily": "SF Compact, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
    "fontWeight": 457,
    "letterSpacing": 0,
    "textRendering": "optimizeLegibility"
  },
  "components": {
    "close_gauge": {
      "figmaReference": {
        "componentSetNodeId": "560:871",
        "componentName": "Close Gauge"
      },
      "semanticComponentSpec": {
        "description": "Closed circular gauge for a single metric with optional center icon or value plus label.",
        "validProperties": ["icon", "text"],
        "validSizes": ["S", "M", "L"]
      },
      "variantApi": {
        "component": "close_gauge",
        "variant": {
          "property": "icon|text",
          "size": "S|M|L"
        },
        "data": {
          "progress": "number from 0 to 1",
          "value": "required for property=text",
          "label": "required for property=text",
          "icon": "required for property=icon",
          "metricKind": "optional semantic color hint"
        }
      },
      "exactVisualTokens": {
        "shape": "closed_progress_ring",
        "sizes": {
          "S": {
