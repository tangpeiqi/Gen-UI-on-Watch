            "text": {
              "value": { "fontSize": 22, "lineHeight": 24.5, "centerX": 36, "centerY": 36, "box": { "x": 9.6, "y": 24.8, "width": 52.8, "height": 22.4 } },
              "label": { "fontSize": 10, "lineHeight": 12.5, "centerX": 36, "centerY": 52, "box": { "x": 16, "y": 47.2, "width": 40, "height": 9.6 } }
            }
          },
          "M": {
            "diameter": 90,
            "strokeWidth": 10,
            "radius": 39.5,
            "center": { "x": 45, "y": 45 },
            "iconBox": { "x": 26, "y": 26, "width": 38, "height": 38 },
            "text": {
              "value": { "fontSize": 32, "lineHeight": 34.5, "centerX": 45, "centerY": 45, "box": { "x": 12, "y": 31, "width": 66, "height": 28 } },
              "label": { "fontSize": 15, "lineHeight": 17.5, "centerX": 45, "centerY": 65, "box": { "x": 20, "y": 59, "width": 50, "height": 12 } }
            }
          },
          "L": {
            "diameter": 149,
            "strokeWidth": 15,
            "radius": 66.5,
            "center": { "x": 74.5, "y": 74.5 },
